# Uploaded files may only be images. Never run scripts from here.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
